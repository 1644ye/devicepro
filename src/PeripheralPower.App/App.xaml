<Application x:Class="PeripheralPower.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F3F5F8" /><SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InkBrush" Color="#182433" /><SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="LineBrush" Color="#DDE3EB" /><SolidColorBrush x:Key="AccentBrush" Color="#167D70" />
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" /><Setter Property="FontSize" Value="13" /><Setter Property="Background" Value="{DynamicResource CanvasBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="13,7" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Background" Value="{DynamicResource CardBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="Cursor" Value="Hand" /></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="7,5" /><Setter Property="Background" Value="{DynamicResource CardBrush}" /><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Margin" Value="0,6,14,6" /></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,4" /><Setter Property="MinWidth" Value="130" /><Setter Property="Foreground" Value="#182433" /><Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="#182433" /></DataTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#182433" /><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="#182433" /></DataTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#182433" /><Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="#182433" /></DataTemplate></Setter.Value></Setter></Style>
    <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource InkBrush}" /><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,6,0,12" /></Style>
    <DataTemplate x:Key="DeviceCard">
      <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,9">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="18" Margin="0,1,9,0" /><TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></Grid>
            <TextBlock Text="{Binding Connection}" Style="{StaticResource MutedText}" Margin="0,10,0,0" /><TextBlock Text="{Binding Updated}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="14,0,0,0"><TextBlock Text="{Binding Battery}" FontSize="29" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" /><TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" MaxWidth="130" TextAlignment="Right" /></StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Application.Resources>
</Application>
