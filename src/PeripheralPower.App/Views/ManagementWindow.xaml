<Window x:Class="PeripheralPower.App.Views.ManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="外设电量 · 设备管理" Width="960" Height="740" MinWidth="760" MinHeight="600" WindowStartupLocation="CenterScreen">
  <Grid Margin="24" Background="{DynamicResource CanvasBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><StackPanel><TextBlock Text="外设电量" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="选好设备，其余交给托盘。" Style="{StaticResource MutedText}" Margin="0,5,0,0" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="简洁面板" Click="ShowPanel" /><Button Content="立即刷新" Click="Refresh" /><Button Content="隐藏到托盘" Click="HideToTray" Margin="0" /></StackPanel></Grid>
    <TabControl x:Name="ManagementTabs" Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}">
      <TabItem Header="我的设备" Padding="18,9"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="所有窗口共享同一份读数。隐藏卡片仍保留监测，移除才停止。" Style="{StaticResource MutedText}" Margin="0,0,0,14" />
        <ListBox x:Name="TargetsList" Grid.Row="1" SelectionChanged="TargetSelected" Background="{DynamicResource CanvasBrush}" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource DeviceCard}" />
        <WrapPanel Grid.Row="2" Margin="0,12,0,0"><TextBox x:Name="RenameBox" Width="190" ToolTip="显示名称" /><Button Content="保存名称" Click="Rename" Margin="8,0,8,0" /><Button Content="上移" Click="MoveUp" /><Button Content="下移" Click="MoveDown" /><Button Content="隐藏 / 显示" Click="ToggleHidden" /><Button Content="移除" Click="Remove" /></WrapPanel>
        <StackPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="TargetDetail" Style="{StaticResource MutedText}" Text="到“发现设备”中添加监测目标。" TextWrapping="Wrap" MaxHeight="95" /><TextBlock Text="手动关联：在发现页选中另一个连接模式，再点“关联到当前目标”。仅在确认属于同一实物时关联。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" /></StackPanel>
      </Grid></TabItem>
      <TabItem Header="发现设备" Padding="18,9"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14"><Button Content="重新发现" Click="Discover" DockPanel.Dock="Right" Margin="10,0,0,0" /><TextBlock Text="真实系统设备；同一 Container ID 的接口合并显示。" Style="{StaticResource MutedText}" VerticalAlignment="Center" /></DockPanel>
        <ListBox x:Name="DiscoveryList" Grid.Row="1" DisplayMemberPath="Label" SelectionChanged="DiscoveredSelected" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource LineBrush}" />
        <TextBox x:Name="DiscoveryDetail" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="150" Margin="0,12,0,12" />
        <WrapPanel Grid.Row="3"><Button Content="加入我的设备" Click="AddTarget" /><Button Content="关联到当前目标" Click="LinkTarget" /><TextBlock x:Name="DiscoveryStatus" Style="{StaticResource MutedText}" VerticalAlignment="Center" /></WrapPanel>
      </Grid></TabItem>
      <TabItem x:Name="SettingsTab" Header="全局设置与诊断" Padding="18,9"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
        <TextBlock Text="刷新" Style="{StaticResource SectionTitle}" /><CheckBox x:Name="AutoRefreshBox" Content="开启自动刷新" />
        <WrapPanel Margin="0,4,0,0"><ComboBox x:Name="IntervalPreset" SelectionChanged="PresetChanged"><ComboBoxItem Content="30 秒" Tag="30000" /><ComboBoxItem Content="60 秒" Tag="60000" /><ComboBoxItem Content="5 分钟" Tag="300000" /><ComboBoxItem Content="30 分钟" Tag="1800000" /></ComboBox><TextBox x:Name="IntervalBox" Width="110" Margin="12,0,8,0" /><TextBlock Text="毫秒（30000–1800000）" VerticalAlignment="Center" Style="{StaticResource MutedText}" /></WrapPanel>
        <TextBlock Text="周期采用 Windows SetTimer。没有监测目标时停止周期刷新。" Style="{StaticResource MutedText}" Margin="0,10,0,18" />
        <TextBlock Text="启动与外观" Style="{StaticResource SectionTitle}" /><CheckBox x:Name="StartupBox" Content="登录 Windows 后静默启动到托盘" /><TextBlock x:Name="StartupStatus" Style="{StaticResource MutedText}" />
        <WrapPanel Margin="0,12,0,0"><TextBlock Text="手动启动时" VerticalAlignment="Center" Margin="0,0,12,0" /><ComboBox x:Name="LaunchBox"><ComboBoxItem Content="管理窗口" /><ComboBoxItem Content="简洁面板" /><ComboBoxItem Content="仅托盘" /></ComboBox><TextBlock Text="主题" VerticalAlignment="Center" Margin="22,0,12,0" /><ComboBox x:Name="ThemeBox"><ComboBoxItem Content="浅色" /><ComboBoxItem Content="深色" /></ComboBox></WrapPanel>
        <Button Content="保存并立即应用" Click="SaveSettings" HorizontalAlignment="Left" Margin="0,18,0,0" /><TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,18" />
        <TextBlock Text="诊断与支持" Style="{StaticResource SectionTitle}" /><TextBlock Text="诊断包含设备路径、VID/PID、接口和读取错误，保存在你选择的本地文件；不会采集按键内容。系统属性缓存会明确标记，缓存获取时间不表示设备采样时间。" Style="{StaticResource MutedText}" />
        <WrapPanel Margin="0,14,0,0"><Button Content="导出诊断" Click="Export" /><Button Content="打开数据目录" Click="OpenDataFolder" /><Button Content="退出程序" Click="ExitApp" /></WrapPanel>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <TextBlock x:Name="Footer" Grid.Row="2" Style="{StaticResource MutedText}" Text="左键托盘显示面板 · 右键托盘打开全局设置 · 关闭窗口继续监测" Margin="0,14,0,0" FontSize="11" />
  </Grid>
</Window>
