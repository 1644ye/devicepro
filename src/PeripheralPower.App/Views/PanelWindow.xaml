<Window x:Class="PeripheralPower.App.Views.PanelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="我的设备 · 外设电量" Width="420" Height="450" MinWidth="350" MinHeight="210" ShowInTaskbar="False" WindowStartupLocation="CenterScreen">
  <Grid Margin="16" Background="{DynamicResource CanvasBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid Margin="1,0,1,14" MouseLeftButtonDown="DragHeader"><TextBlock Text="我的设备" FontSize="17" FontWeight="SemiBold" /><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="外设电量" Style="{StaticResource MutedText}" FontSize="11" /></Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource DeviceCard}" /><Button x:Name="EmptyButton" Content="添加我的设备" Click="OpenManagement" HorizontalAlignment="Center" Margin="0,28,0,0" /></StackPanel></ScrollViewer>
  </Grid>
</Window>
